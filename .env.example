# Copy to .env.local for local development. Everything NEXT_PUBLIC_* is shipped
# to the browser -- never put a secret here.
#
# These are service URLs, which are public by nature. The access token is never
# stored here or anywhere else on disk: it lives in memory for the life of the
# tab. See lib/auth.tsx for why.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_URL=http://localhost:8001
